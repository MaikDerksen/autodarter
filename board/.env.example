# Address of your Autodarter server. Over the internet always use https://
# (can also be changed later on the status page http://<pi>:3180)
AUTODARTER_SERVER=https://darts.example.com

# Allow "Pi neu starten" from the web app
ALLOW_REBOOT=true

# Only if the network needs an outgoing proxy (company networks), e.g. http://proxy.firma.local:3128
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=

# v4l2 = real USB cameras, sim = simulated board (for testing without hardware)
CAMERA_SOURCE=v4l2

# Optional: fixed camera devices instead of auto-detection, e.g. /dev/video0,/dev/video2,/dev/video4
CAMERAS=

LOCAL_PORT=3180
LOG_LEVEL=INFO

# --- Images & automatic updates ---
# Ready-made arm64 images: maik05 (Docker Hub) – no build on the Pi needed
AUTODARTER_REGISTRY=maik05
AUTODARTER_TAG=latest
# autoupdate = pull new versions automatically (and "Software aktualisieren" in the app)
COMPOSE_PROFILES=autoupdate
UPDATE_INTERVAL=21600
UPDATE_HOURS=
TZ=Europe/Berlin
