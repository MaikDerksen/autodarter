# Address of your Autodarter server (can also be set later on the status page http://<pi>:3180)
AUTODARTER_SERVER=http://192.168.1.10:3000

# v4l2 = real USB cameras, sim = simulated board (for testing without hardware)
CAMERA_SOURCE=v4l2

# Optional: fixed camera devices instead of auto-detection, e.g. /dev/video0,/dev/video2,/dev/video4
CAMERAS=

LOCAL_PORT=3180
LOG_LEVEL=INFO
