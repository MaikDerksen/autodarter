# Server stack configuration (copy to .env)

# Long random string, e.g. `openssl rand -hex 32` – required
JWT_SECRET=
# Database password (internal to the compose network)
POSTGRES_PASSWORD=autodarter
# Port of the web app / API in the home network (plain HTTP)
PORT=3000
# Set to false after you created your accounts – important when the server is reachable from the internet
ALLOW_REGISTRATION=true
LOG_LEVEL=info

# --- Access from the internet (choose one profile) ---
# --profile https : your DNS name (e.g. DynDNS) – router must forward ports 80 + 443 to this machine
DOMAIN=
# --profile tunnel: token of a Cloudflare Tunnel (Zero Trust > Networks > Tunnels), route to http://server:3000
CLOUDFLARE_TUNNEL_TOKEN=

# Live camera view quality (lower it if the upload at the board location is slow)
STREAM_FPS=4
STREAM_MAX_WIDTH=640

# A running match blocks its board for other players; after this many idle minutes it may be taken over
BOARD_IDLE_MINUTES=30
# Running matches without any dart for this many hours are ended automatically
STALE_MATCH_HOURS=12
# Who may press "Server aktualisieren" in the app (usernames, comma separated). Empty = the first registered account.
ADMIN_USERS=

# --- Images & automatic updates ---
# Ready-made images: maik05 (Docker Hub) or ghcr.io/<github-user>
# Empty = build locally (docker compose up -d --build)
AUTODARTER_REGISTRY=
# latest = every change on main, stable = only releases, sha-abc1234 = pinned version
AUTODARTER_TAG=latest
# Profiles that start with a plain "docker compose up -d", e.g. tunnel,autoupdate
COMPOSE_PROFILES=
# Auto-update: check every 6 h, optionally only in a time window (local time), never during a match
UPDATE_INTERVAL=21600
UPDATE_HOURS=3-6
TZ=Europe/Berlin
